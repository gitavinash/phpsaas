# WhatsApp Gateway Configuration for Production
# Copy this file to .env in this folder on your production server:
# cp .env.example .env

# Port the Node.js daemon runs on (default 3001)
PORT=3001

# Fallback CRM Webhook URL
# For dynamic domains / multi-tenant CRM:
# The gateway automatically detects and routes each session's webhook to the exact dynamic domain
# that initiated it (persisted per session).
#
# Use the local loopback address as the default fallback:
CRM_WEBHOOK_URL=http://127.0.0.1/api/v3/whatsapp/webhook.php
