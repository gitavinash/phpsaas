# WhatsApp Gateway Configuration for Production
# Copy this file to .env on your production server:
# cp .env.example .env

# Port the Node.js daemon runs on (default 3001)
PORT=3001

# The full URL to your CRM incoming webhook endpoint.
# On production, use your actual domain with https (e.g. https://crm.yourdomain.com/api/v3/whatsapp/webhook.php)
CRM_WEBHOOK_URL=http://localhost/api/v3/whatsapp/webhook.php
